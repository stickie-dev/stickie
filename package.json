{
  "name": "stickie",
  "version": "0.0.0",
  "private": true,
  "description": "Not another Editor — Notes for Agents. Local review surface for agent-made changes.",
  "type": "module",
  "bin": {
    "stickie": "./bin/stickie.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @stickie/server --filter @stickie/client dev",
    "build": "pnpm --filter @stickie/client build && pnpm --filter @stickie/server build",
    "start": "node server/dist/index.js",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "packageManager": "pnpm@11.18.0"
}
