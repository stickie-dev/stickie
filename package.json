{
  "name": "stickie",
  "version": "0.1.0-rc1",
  "private": true,
  "description": "Notes for your coding agents: a local review surface for agent-made changes.",
  "homepage": "https://github.com/stickie-dev/stickie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stickie-dev/stickie.git"
  },
  "bugs": {
    "url": "https://github.com/stickie-dev/stickie/issues"
  },
  "type": "module",
  "bin": {
    "stickie": "./bin/stickie.js",
    "stickie-mcp": "./bin/stickie-mcp.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @stickie/server --filter @stickie/client dev",
    "build": "pnpm --filter @stickie/client build && pnpm --filter @stickie/server build && pnpm --filter @stickie/desktop build",
    "desktop": "pnpm build && pnpm --filter @stickie/desktop start",
    "desktop:dev": "pnpm --filter @stickie/desktop build && pnpm --filter @stickie/desktop exec electron . --dev",
    "desktop:dist": "pnpm build && node desktop/scripts/stage.mjs && pnpm --filter @stickie/desktop exec electron-builder --config electron-builder.json",
    "start": "node server/dist/index.js",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "package": "pnpm build && node scripts/package.mjs",
    "package:pypi": "uv build python",
    "showcase": "bash scripts/showcase/run.sh"
  },
  "packageManager": "pnpm@11.18.0",
  "license": "Apache-2.0"
}
