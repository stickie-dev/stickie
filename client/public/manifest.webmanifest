{
  "name": "stickie — review notes for agents",
  "short_name": "stickie",
  "description": "A local, read-only review surface for changes made by coding agents.",
  "start_url": "/",
  "scope": "/",
  "display_override": ["window-controls-overlay"],
  "display": "standalone",
  "background_color": "#f7f7f6",
  "theme_color": "#f7f7f6",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
